@model AdminCataloguePageViewModel
@{
    ViewData["Title"] = "Admin - Catalogue";

    var camelCase = new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    };

    // Auth0 user IDs always contain a "|" (google-oauth2|123..., auth0|abc...). Anything
    // without one (staff-a, unlinked-robert) is a placeholder no real login can match yet.
    bool LooksLinked(string userId) => userId.Contains('|');
}

<section class="page-intro">
    <div class="wrap">
        <div class="tag">Staff &middot; Admin</div>
        <h1>Catalogue</h1>
        <p>
            Manage the services and barbers customers see when booking. Nothing is ever
            deleted &mdash; deactivating hides a service or barber from booking but keeps
            every past booking intact.
        </p>
    </div>
</section>

<section>
    <div class="wrap" id="admin-page" style="padding-bottom: 80px;">
        @if (Model.ErrorMessage is not null)
        {
            <p class="price-note" data-api-waking="@(ApiErrorMessages.IsWakingUp(Model.ErrorMessage) ? "" : null)">@Model.ErrorMessage</p>
        }
        else
        {
            @* ------------------------------ Services ------------------------------ *@
            <h2 style="font-family:var(--display); font-weight:600; font-size:20px; color:var(--heading); margin-bottom:14px;">Services</h2>

            <p id="services-message" class="form-error" style="margin:0 0 12px;"></p>

            <button id="add-service-btn" class="add-toggle-btn neo-raised" type="button">+ Add a service</button>

            <div id="service-form" class="panel neo-raised" style="display:none; padding:24px; margin-bottom:20px;">
                <input type="hidden" id="service-id" />
                <div class="field-row">
                    <div class="form-field">
                        <label>Name</label>
                        <div class="input-shell neo-pressed"><input type="text" id="service-name" maxlength="80" placeholder="e.g. Skin fade" /></div>
                    </div>
                    <div class="form-field">
                        <label>Price (R)</label>
                        <div class="input-shell neo-pressed"><input type="number" id="service-price" min="0" max="10000" step="0.01" placeholder="230" /></div>
                    </div>
                </div>
                <div class="field-row">
                    <div class="form-field">
                        <label>Duration (minutes)</label>
                        <div class="input-shell neo-pressed"><input type="number" id="service-duration" min="1" max="480" step="1" placeholder="30" /></div>
                    </div>
                    <div></div>
                </div>
                <div style="display:flex; gap:16px; align-items:center; flex-wrap:wrap;">
                    <button id="service-save-btn" class="btn-confirm neo-pill-raised" type="button">Save service</button>
                    <button id="service-cancel-btn" class="row-link" type="button">Cancel</button>
                </div>
                <p id="service-error" class="form-error" style="margin-top:12px;"></p>
            </div>

            <div id="services-list" class="panel neo-raised" style="padding: 8px 18px; margin-bottom: 48px;">
                @if (Model.Services.Count == 0)
                {
                    <p class="no-date-msg" style="padding:16px 0;">No services yet.</p>
                }
                @foreach (var service in Model.Services)
                {
                    <div class="admin-row service-item"
                         data-id="@service.Id"
                         data-name="@service.Name"
                         data-price-cents="@service.PriceCents"
                         data-duration="@service.DurationMinutes"
                         data-active="@(service.Active ? "true" : "false")"
                         style="margin-bottom:0; padding:16px 0; border-bottom:1px solid var(--sh-dark-soft);@(service.Active ? "" : " opacity:0.6;")">
                        <div>
                            <div class="aname">@service.Name</div>
                            <div class="adesc">@service.DurationMinutes min</div>
                        </div>
                        <div style="display:flex; align-items:center; gap:20px; flex-wrap:wrap; justify-content:flex-end;">
                            <span class="aprice">@PriceFormatter.FormatZarCents(service.PriceCents)</span>
                            <span class="badge-pill @(service.Active ? "badge-teal" : "badge-grey")">@(service.Active ? "Active" : "Inactive")</span>
                            <button class="row-link teal edit-service-btn" type="button">Edit</button>
                            <button class="row-link @(service.Active ? "brick" : "teal") toggle-service-btn" type="button">@(service.Active ? "Deactivate" : "Activate")</button>
                        </div>
                    </div>
                }
            </div>

            @* ------------------------------ Products ------------------------------ *@
            <h2 style="font-family:var(--display); font-weight:600; font-size:20px; color:var(--heading); margin-bottom:14px;">Shop inventory</h2>
            <p class="price-note" style="margin-top:0;">Stock is reserved when a customer adds an item to a booking and automatically returned if that booking is cancelled.</p>
            <p id="products-message" class="form-error" style="margin:0 0 12px;"></p>
            <button id="add-product-btn" class="add-toggle-btn neo-raised" type="button">+ Add a product</button>
            <div id="product-form" class="panel neo-raised" style="display:none; padding:24px; margin-bottom:20px;">
                <input type="hidden" id="product-id" />
                <div class="field-row">
                    <div class="form-field"><label>Name</label><div class="input-shell neo-pressed"><input id="product-name" maxlength="100" placeholder="e.g. Styling cream" /></div></div>
                    <div class="form-field"><label>Price (R)</label><div class="input-shell neo-pressed"><input id="product-price" type="number" min="0" max="10000" step="0.01" placeholder="250" /></div></div>
                </div>
                <div class="field-row"><div class="form-field"><label>Current stock</label><div class="input-shell neo-pressed"><input id="product-stock" type="number" min="0" max="100000" step="1" placeholder="20" /></div></div><div></div></div>
                <div class="field-row">
                    <div class="form-field"><label>Category</label><div class="input-shell neo-pressed"><input id="product-category" maxlength="60" placeholder="e.g. Styling" /></div></div>
                    <div class="form-field"><label>Low-stock warning at</label><div class="input-shell neo-pressed"><input id="product-low-stock" type="number" min="1" max="1000" step="1" value="5" /></div></div>
                </div>
                <div class="form-field"><label>Description</label><div class="input-shell neo-pressed review-box"><textarea id="product-description" maxlength="500" placeholder="Explain what the product is best for."></textarea></div></div>
                <div class="field-row">
                    <div class="form-field"><label>Product image URL</label><div class="input-shell neo-pressed"><input id="product-image-url" type="url" maxlength="2048" placeholder="https://..." /></div><p class="adesc" style="margin-top:6px;">Use a direct public image link (https preferred).</p></div>
                    <div class="form-field"><label>Display order</label><div class="input-shell neo-pressed"><input id="product-display-order" type="number" min="-10000" max="10000" step="1" value="0" /></div></div>
                </div>
                <div style="display:flex; gap:16px; align-items:center; flex-wrap:wrap;"><button id="product-save-btn" class="btn-confirm neo-pill-raised" type="button">Save product</button><button id="product-cancel-btn" class="row-link" type="button">Cancel</button></div>
                <p id="product-error" class="form-error" style="margin-top:12px;"></p>
            </div>
            <div id="products-list" class="panel neo-raised" style="padding:8px 18px; margin-bottom:48px;">
                @foreach (var product in Model.Products)
                {
                    var status = product.StockQuantity == 0 ? "Out of stock" : product.StockQuantity <= product.LowStockThreshold ? $"Low: {product.StockQuantity} left" : product.StockQuantity >= 20 ? "Fully stocked" : $"In stock: {product.StockQuantity}";
                    <div class="admin-row product-item" data-id="@product.Id" data-name="@product.Name" data-price-cents="@product.PriceCents" data-stock="@product.StockQuantity" data-description="@product.Description" data-category="@product.Category" data-image-url="@product.ImageUrl" data-low-stock="@product.LowStockThreshold" data-display-order="@product.DisplayOrder" data-active="@(product.Active ? "true" : "false")" style="margin-bottom:0; padding:16px 0; border-bottom:1px solid var(--sh-dark-soft);@(product.Active ? "" : " opacity:0.6;")">
                        <div><div class="aname">@product.Name</div><div class="adesc">@status &middot; @PriceFormatter.FormatZarCents(product.PriceCents)@(string.IsNullOrWhiteSpace(product.Category) ? "" : $" · {product.Category}")</div></div>
                        <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap; justify-content:flex-end;">
                            <button class="row-link teal stock-adjust-btn" data-delta="1" type="button">+ Stock</button><button class="row-link brick stock-adjust-btn" data-delta="-1" type="button">- Stock</button>
                            <button class="row-link teal edit-product-btn" type="button">Edit</button><button class="row-link @(product.Active ? "brick" : "teal") toggle-product-btn" type="button">@(product.Active ? "Hide" : "Show")</button>
                        </div>
                    </div>
                }
                @if (Model.Products.Count == 0) { <p class="no-date-msg" style="padding:16px 0;">No products yet.</p> }
            </div>

            @* ------------------------------ Barbers ------------------------------- *@
            <h2 style="font-family:var(--display); font-weight:600; font-size:20px; color:var(--heading); margin-bottom:14px;">Barbers</h2>

            <p id="barbers-message" class="form-error" style="margin:0 0 12px;"></p>

            <button id="add-barber-btn" class="add-toggle-btn neo-raised" type="button">+ Add a barber</button>

            <div id="barber-form" class="panel neo-raised" style="display:none; padding:24px; margin-bottom:20px;">
                <input type="hidden" id="barber-id" />
                <div class="field-row">
                    <div class="form-field">
                        <label>Name</label>
                        <div class="input-shell neo-pressed"><input type="text" id="barber-name" maxlength="80" placeholder="e.g. Frankie" /></div>
                    </div>
                    <div class="form-field">
                        <label>Linked login (Auth0 user ID)</label>
                        <div class="input-shell neo-pressed"><input type="text" id="barber-user-id" maxlength="128" placeholder="google-oauth2|123... or unlinked-frankie" /></div>
                    </div>
                </div>
                <p style="font-size:13px; color:var(--text-dim); margin:-6px 0 18px;">
                    Each barber needs a unique ID. Use the barber's Auth0 user ID once they have a login
                    (it's on their user page in Auth0); until then a placeholder such as
                    <span style="font-family:var(--mono);">unlinked-frankie</span> works and can be replaced later.
                </p>

                <label>Working hours</label>
                <div id="hours-list"></div>
                <div style="display:flex; gap:16px; align-items:center; flex-wrap:wrap; margin-bottom:22px;">
                    <button id="add-period-btn" class="row-link teal" type="button">+ Add a working period</button>
                    <button id="fill-preset-btn" class="row-link teal" type="button">Fill Mon to Sat, 09:00 to 17:00</button>
                </div>

                <label>Services this barber can perform</label>
                <p style="font-size:13px; color:var(--text-dim); margin:4px 0 10px;">Customers will only be offered this barber for the selected services.</p>
                <div id="barber-skills" style="display:flex; gap:10px 18px; flex-wrap:wrap; margin-bottom:22px;">
                    @foreach (var service in Model.Services.Where(service => service.Active))
                    {
                        <label style="display:flex; align-items:center; gap:6px; cursor:pointer;">
                            <input class="barber-skill" type="checkbox" value="@service.Id" /> @service.Name
                        </label>
                    }
                </div>

                <div style="display:flex; gap:16px; align-items:center; flex-wrap:wrap;">
                    <button id="barber-save-btn" class="btn-confirm neo-pill-raised" type="button">Save barber</button>
                    <button id="barber-cancel-btn" class="row-link" type="button">Cancel</button>
                </div>
                <p id="barber-error" class="form-error" style="margin-top:12px;"></p>
            </div>

            <div id="barbers-list" class="panel neo-raised" style="padding: 8px 18px;">
                @if (Model.Barbers.Count == 0)
                {
                    <p class="no-date-msg" style="padding:16px 0;">No barbers yet.</p>
                }
                @foreach (var barber in Model.Barbers)
                {
                    var hoursJson = System.Text.Json.JsonSerializer.Serialize(barber.Hours, camelCase);
                    var serviceIdsJson = System.Text.Json.JsonSerializer.Serialize(barber.ServiceIds, camelCase);
                    var skillNames = barber.ServiceIds is null
                        ? "All active services (legacy profile)"
                        : string.Join(", ", Model.Services.Where(service => barber.ServiceIds.Contains(service.Id)).Select(service => service.Name));

                    <div class="admin-row barber-item"
                         data-id="@barber.Id"
                         data-name="@barber.Name"
                         data-user-id="@barber.UserId"
                         data-hours="@hoursJson"
                         data-service-ids="@serviceIdsJson"
                         data-active="@(barber.Active ? "true" : "false")"
                         style="margin-bottom:0; padding:16px 0; border-bottom:1px solid var(--sh-dark-soft);@(barber.Active ? "" : " opacity:0.6;")">
                        <div>
                            <div class="aname">@barber.Name</div>
                            <div class="adesc">@WorkingHoursFormatter.Format(barber.Hours)</div>
                            <div class="adesc">Services: @(string.IsNullOrEmpty(skillNames) ? "None assigned" : skillNames)</div>
                            <div class="adesc" style="font-family:var(--mono); font-size:11.5px;">
                                @barber.UserId
                                @if (!LooksLinked(barber.UserId))
                                {
                                    <span>&middot; no login linked yet</span>
                                }
                            </div>
                        </div>
                        <div style="display:flex; align-items:center; gap:20px; flex-wrap:wrap; justify-content:flex-end;">
                            <span class="badge-pill @(barber.Active ? "badge-teal" : "badge-grey")">@(barber.Active ? "Active" : "Inactive")</span>
                            <button class="row-link teal edit-barber-btn" type="button">Edit</button>
                            <button class="row-link @(barber.Active ? "brick" : "teal") toggle-barber-btn" type="button">@(barber.Active ? "Deactivate" : "Activate")</button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<script src="~/js/auth-fetch.js" asp-append-version="true"></script>
<script src="~/js/admin.js" asp-append-version="true"></script>
