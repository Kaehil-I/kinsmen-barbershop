@model List<RetailProduct>
@{
    ViewData["Title"] = "Shop";
    var errorMessage = ViewData["ErrorMessage"] as string;
}

<section class="page-intro">
    <div class="wrap">
        <div class="tag">Kinsmen Grooming</div>
        <h1>Shop products</h1>
        <p>Professional styling and beard-care products, available to purchase in store.</p>
    </div>
</section>

<section>
    <div class="wrap" style="padding-bottom:80px;">
        @if (errorMessage is not null)
        {
            <p class="price-note" data-api-waking="@(ApiErrorMessages.IsWakingUp(errorMessage) ? "" : null)">@errorMessage</p>
        }
        else
        {
            <p class="price-note">Reserve in-stock products with your appointment. You will collect and pay for them at Kinsmen.</p>
            <div class="shop-grid">
                @foreach (var product in Model)
                {
                    var outOfStock = product.StockQuantity == 0;
                    var lowStock = product.StockQuantity is > 0 && product.StockQuantity <= product.LowStockThreshold;
                    var fullyStocked = product.StockQuantity >= 20;
                    <article class="panel neo-raised shop-product">
                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" alt="@product.Name" loading="lazy" referrerpolicy="no-referrer" style="width:100%; height:130px; object-fit:cover; border-radius:12px;" />
                        }
                        else
                        {
                            <div class="shop-product-mark" aria-hidden="true">K</div>
                        }
                        <div>
                            @if (!string.IsNullOrWhiteSpace(product.Category)) { <div class="tag" style="font-size:10px; margin-bottom:5px;">@product.Category</div> }
                            <div class="name">@product.Name</div>
                            <p class="shop-product-note">@(string.IsNullOrWhiteSpace(product.Description) ? "Available at Kinsmen Barbers" : product.Description)</p>
                        </div>
                        <div class="shop-product-footer">
                            <strong class="price">@PriceFormatter.FormatZarCents(product.PriceCents)</strong>
                            <span class="stock-badge @(outOfStock ? "stock-low" : lowStock ? "stock-low" : "")">
                                @(outOfStock ? "Out of stock" : lowStock ? $"Low stock: {product.StockQuantity} left" : fullyStocked ? "Fully stocked" : $"In stock: {product.StockQuantity}")
                            </span>
                        </div>
                    </article>
                }
            </div>
            <div class="panel neo-raised shop-callout">
                <div>
                    <h2>Need help choosing?</h2>
                    <p>Ask your barber which product works best for your hair or beard routine.</p>
                </div>
                <a asp-controller="Booking" asp-action="Index" class="book-link neo-pill-raised">Book and reserve products</a>
            </div>
        }
    </div>
</section>
