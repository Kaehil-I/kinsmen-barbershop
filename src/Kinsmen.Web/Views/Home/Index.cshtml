@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="wrap">
        <div class="tag">Durban North &middot; Classic Barbershop</div>
        <h1>A proper cut, a proper shave, no fuss about it.</h1>
        <p>
            Kinsmen is a classic barbershop on Mackeurtan Ave &mdash; blade &amp; tapered
            fades, hot-towel prep and a traditional straight-razor finish. Pick a barber,
            pick a time, and we'll have the chair warm for you.
        </p>

        @if (User.IsStaff())
        {
            <a asp-controller="BarberSchedule" asp-action="Index" class="scroll-cue">
                <span>Go to My Schedule</span>
                <svg width="12" height="8" viewBox="0 0 12 8" fill="none"><path d="M1 1l5 5 5-5" stroke="#7C3626" stroke-width="1.6" /></svg>
            </a>
        }
        else
        {
            <a asp-controller="Booking" asp-action="Index" class="scroll-cue">
                <span>Book a Chair</span>
                <svg width="12" height="8" viewBox="0 0 12 8" fill="none"><path d="M1 1l5 5 5-5" stroke="#7C3626" stroke-width="1.6" /></svg>
            </a>
        }

        <div class="quick-facts">
            <div class="neo-raised-sm">
                <strong><span class="dot" style="background:var(--accent)"></span>Mon &ndash; Sat</strong>
                <span>09:00 &ndash; 18:00</span>
            </div>
            <div class="neo-raised-sm">
                <strong><span class="dot" style="background:var(--teal)"></span>Sunday</strong>
                <span>09:00 &ndash; 15:00</span>
            </div>
            <div class="neo-raised-sm">
                <strong><span class="dot" style="background:var(--teal)"></span>Accounts</strong>
                <span>Sign in to book</span>
            </div>
        </div>
    </div>
</section>

<section class="home-features">
    <div class="wrap">
        <h2>Everything in one place</h2>
        <p class="lede">Book, manage and shop with Kinsmen online. Each part of the site has its own page.</p>
        <div class="feature-grid">
            <a asp-controller="Booking" asp-action="Index" class="panel neo-raised feature-card">
                <span class="ficon" aria-hidden="true">01</span>
                <h3>Book a chair</h3>
                <p>Pick one or more services, a barber (or any available barber) and a time that suits you.</p>
                <span class="flink">Start a booking &rarr;</span>
            </a>
            <a asp-controller="Team" asp-action="Index" class="panel neo-raised feature-card teal">
                <span class="ficon" aria-hidden="true">02</span>
                <h3>Meet the barbers</h3>
                <p>See who works at Kinsmen, what each barber specialises in and when they are in.</p>
                <span class="flink">See the team &rarr;</span>
            </a>
            <a asp-controller="Shop" asp-action="Index" class="panel neo-raised feature-card ochre">
                <span class="ficon" aria-hidden="true">03</span>
                <h3>Shop products</h3>
                <p>Browse grooming products and reserve them with your booking. Collect and pay in store.</p>
                <span class="flink">Browse the shop &rarr;</span>
            </a>
            <a asp-controller="MyBookings" asp-action="Index" class="panel neo-raised feature-card">
                <span class="ficon" aria-hidden="true">04</span>
                <h3>Manage bookings</h3>
                <p>Reschedule or cancel, rebook a past visit, and receive a reminder when email notifications are enabled.</p>
                <span class="flink">My bookings &rarr;</span>
            </a>
        </div>
    </div>
</section>
