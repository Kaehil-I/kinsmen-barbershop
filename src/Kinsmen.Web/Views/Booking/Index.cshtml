@model BookingPageViewModel
@{
    ViewData["Title"] = "Book a Chair";
    var jsonOptions = new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    };
}

<section class="book-head" style="padding: 56px 0 0;">
    <div class="wrap">
        <div class="tag">Book a Chair</div>
        <h2>Choose your barber, day and time</h2>
        <p>Availability shown below is live from the booking system &mdash; pick a barber (or leave it open), your service(s), then a date and time.</p>
    </div>
</section>

@if (Model.ApiUnavailable)
{
    <section>
        <div class="wrap" style="padding-bottom: 80px;">
            <p class="price-note">Couldn't reach the booking service just now &mdash; make sure the API is running (see docs/backend/GETTING-STARTED.md) and refresh.</p>
        </div>
    </section>
}
else if (Model.Services.Count == 0 || Model.Barbers.Count == 0)
{
    <section>
        <div class="wrap" style="padding-bottom: 80px;">
            <p class="price-note">No services or barbers are set up yet &mdash; nothing to book.</p>
        </div>
    </section>
}
else
{
    <section id="book">
        <div class="wrap">
            <div class="booking-shell">

                <div class="field-row">
                    <div class="panel neo-raised">
                        <label for="barber-select" class="accent-teal">Barber</label>
                        <div class="select-shell neo-pressed">
                            <select id="barber-select" class="barber-select">
                                <option value="">Any available barber</option>
                                @foreach (var barber in Model.Barbers)
                                {
                                    <option value="@barber.Id">@barber.Name</option>
                                }
                            </select>
                        </div>
                        <p class="barber-note" id="barber-note">First available chair, whoever's free.</p>
                    </div>

                    <div class="panel neo-raised">
                        <label class="accent-ochre"><span>Service(s)</span> <span style="text-transform:none; letter-spacing:0;">&mdash; pick one or more</span></label>
                        <div class="service-chip-row" id="service-row">
                            @for (var i = 0; i < Model.Services.Count; i++)
                            {
                                var service = Model.Services[i];
                                <button type="button"
                                        class="service-chip @(i == 0 ? "neo-pill-pressed active" : "neo-pill-raised")"
                                        data-service-id="@service.Id">@service.Name</button>
                            }
                        </div>
                    </div>
                </div>

                <div class="picker-row">
                    <div class="panel neo-raised calendar-pane">
                        <div class="cal-head">
                            <span class="month-label" id="cal-month-label">Month Year</span>
                            <div class="cal-nav">
                                <button id="cal-prev" class="neo-pill-raised" aria-label="Previous month" type="button">&lsaquo;</button>
                                <button id="cal-next" class="neo-pill-raised" aria-label="Next month" type="button">&rsaquo;</button>
                            </div>
                        </div>
                        <div class="cal-grid" id="cal-grid"><!-- filled by booking.js --></div>
                    </div>

                    <div class="panel neo-raised time-pane">
                        <div class="time-label-row">
                            <span class="month-label">Available Times</span>
                        </div>
                        <div id="time-grid" class="time-grid">
                            <span class="no-date-msg">Pick a date to see open times.</span>
                        </div>
                    </div>
                </div>

                <div class="panel neo-raised booking-summary" id="summary-panel">
                    <div class="summary-text" id="summary-text">
                        Select a barber, date and time to continue.
                    </div>
                    <button class="btn-confirm neo-pill-raised" id="confirm-btn" disabled type="button">Confirm Booking</button>
                </div>
                <p id="booking-error" style="display:none; color:var(--accent); font-family:var(--mono); font-size:13px; margin-top:-8px;"></p>

                <div class="panel neo-raised success-card" id="success-card">
                    <div class="success-badge">&#10003;</div>
                    <div>
                        <h3>You're booked in</h3>
                        <p id="success-text"></p>
                        <p style="margin-top:8px;"><a href="#" id="book-another" class="link-btn" style="color:var(--teal);">Book another appointment</a></p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <script>
        window.kinsmenBooking = {
            services: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Services, jsonOptions)),
            barbers: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Barbers, jsonOptions))
        };
    </script>
    <script src="~/js/booking.js" asp-append-version="true"></script>
}
